# Kouma Workspace — Environment Variables
# Copy to .env.local (dev) or set in Vercel dashboard (prod). Never commit .env.local.

# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── App ───────────────────────────────────────────────────────────────────────
# Full URL of the app — used for password-reset email redirect links
VITE_APP_URL=https://your-domain.vercel.app
VITE_APP_ENV=production

# ── Web Push (optional — push notifications won't work without this) ──────────
# Generate VAPID keys: npx web-push generate-vapid-keys
# Set the public key here; keep the private key server-side only
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ── Monitoring (optional — errors logged to Supabase even without this) ───────
# Create a free project at https://sentry.io, then paste your DSN below
VITE_SENTRY_DSN=
